# Copy this file to .env and fill in the class service details.
# .env is ignored by git: never commit real keys.
# Any service left blank uses an offline stand-in so the app still runs.

# One key for every class service (each service can override it with its own *_API_KEY)
CLASS_API_KEY=your-class-key-here

# Vision-capable chat model: writes answers and quizzes
LLM_BASE_URL=http://dobolyi.com:9001/v1
LLM_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit

# Text embeddings: search text chunks by meaning (port and model from the class)
TEXT_EMBED_BASE_URL=
TEXT_EMBED_MODEL=

# Visual embeddings: search slide and page images (port and model from the class)
VISUAL_EMBED_BASE_URL=
VISUAL_EMBED_MODEL=

# Multimodal reranker (port and model from the class)
RERANK_BASE_URL=
RERANK_MODEL=

# Document parser: reads text inside images on picture-only slides (optional)
PARSER_BASE_URL=
PARSER_MODEL=

# Search settings (used for the design comparison)
RETRIEVAL_MODE=hybrid        # hybrid | embeddings_only
USE_RERANK=true

# Optional
# DATA_DIR=./data
# SOFFICE_PATH=soffice       # full path to LibreOffice if it isn't on your PATH
# PORT=7860
