# Copy this file to .env and fill in the class service details.
# .env is ignored by git: never commit real keys.
# Any service left blank uses an offline stand-in so the app still runs.

# One key for every class service (each service can override it with its own *_API_KEY)
CLASS_API_KEY=your-class-key-here

# Vision-capable chat model: writes answers and quizzes
# Port 9001 — vLLM, OpenAI-compatible /chat/completions
LLM_BASE_URL=http://dobolyi.com:9001/v1
LLM_MODEL=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit

# Text embeddings: search text chunks by meaning
# Port 9002 — vLLM, /embeddings endpoint
TEXT_EMBED_BASE_URL=http://dobolyi.com:9002/v1
TEXT_EMBED_MODEL=nvidia/Nemotron-3-Embed-1B-BF16

# Visual embeddings: search slide and page images
# Port 9003 — vLLM, /embeddings with chat-style messages
VISUAL_EMBED_BASE_URL=http://dobolyi.com:9003/v1
VISUAL_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B

# Multimodal reranker
# Port 9004 — vLLM, /rerank endpoint (Jina/Cohere-style format)
RERANK_BASE_URL=http://dobolyi.com:9004
RERANK_MODEL=Qwen/Qwen3-VL-Reranker-2B

# Document parser: reads text inside images on picture-only slides (optional)
# Port 9005 — vLLM, /chat/completions endpoint
PARSER_BASE_URL=http://dobolyi.com:9005/v1
PARSER_MODEL=dots.mocr

# Search settings (used for the design comparison)
RETRIEVAL_MODE=hybrid        # hybrid | embeddings_only
USE_RERANK=true

# Optional
# DATA_DIR=./data
# SOFFICE_PATH=soffice       # full path to LibreOffice if it isn't on your PATH
# PORT=7860
